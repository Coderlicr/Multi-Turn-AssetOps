# ── CouchDB (IoTAgent server) ────────────────────────────────────────────────
COUCHDB_URL=http://localhost:5984
IOT_DBNAME=chiller
WO_DBNAME=workorder
COUCHDB_USERNAME=admin
COUCHDB_PASSWORD=password

# ── IBM WatsonX ──────────────────────────────────────────────────────────────
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com   # optional

# ── Model selection ──────────────────────────────────────────────────────────
# Backbone for all agents (supervisor-specialist, plan-execute, stirrup, fmsr).
# The prefix picks the endpoint and its credentials:
#   watsonx/*      -> WATSONX_APIKEY / WATSONX_PROJECT_ID / WATSONX_URL
#   tokenrouter/*  -> TOKENROUTER_API_KEY / TOKENROUTER_BASE_URL
#   litellm_proxy/* and anything else -> LITELLM_API_KEY / LITELLM_BASE_URL
# e.g. tokenrouter/z-ai/glm-5.3-flash
DEFAULT_MODEL_ID=

# ── LiteLLM ──────────────────────────────────────────────────────────────────
LITELLM_API_KEY=
LITELLM_BASE_URL=

# ── TokenRouter (any agent, when the model id starts with tokenrouter/) ──────
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1

# ── Tool output root ─────────────────────────────────────────────────────────
# Where the MCP servers write. Defaults to /tmp/assetops when unset or empty.
#   datasets/  sensor exports keyed by asset and window; reused across runs
#   work/      scratch for a single tool call; safe to delete wholesale
#   outputs/   results an artifact points at; deleting these breaks the artifact
# Set this to move everything off /tmp, e.g. to survive a reboot or free space.
# ASSETOPS_TMP_ROOT=/tmp/assetops
