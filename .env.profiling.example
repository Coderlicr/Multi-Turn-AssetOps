# Optional profiling integrations for eval/run_eval.py.
# Copy this file to .env.profiling and fill in real values.

# LangSmith traces for LiteLLM/LangGraph calls
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=multi-turn-assetops

# WandB metrics logged by the eval harness only
WANDB_API_KEY=
WANDB_PROJECT=multi-turn-assetops
