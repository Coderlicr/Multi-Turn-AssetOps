# OpenAI-compatible endpoint used by a litellm_proxy/* model ID.
LITELLM_BASE_URL=https://your-endpoint.example/v1
LITELLM_API_KEY=replace-me

# Optional native LiteLLM-provider credentials can also be set here.
# WATSONX_APIKEY=replace-me
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_PROJECT_ID=replace-me

